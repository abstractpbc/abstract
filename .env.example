# Copy to .env (gitignored) and fill in locally. Never commit, print or log the values.
# `abstract eval` with the scripted policy on cubepick needs none of these.

# Abstract API key: the hosted action models (`[vla] server_url = "https://api.abstract.inc/v1"`)
# and the runs store (`[store] route = "abstract"`). `abstract login` can save one instead.
ABSTRACT_API_KEY=
# OpenAI: the LLM agent policy (`[agent]`). On a rig, `abstract robot` reads its key from the
# file named in the robot TOML instead (default ~/.config/abstract/openai.env, chmod 600).
OPENAI_API_KEY=
